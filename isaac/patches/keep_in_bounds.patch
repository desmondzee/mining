+def grid_passable(raw: dict) -> Passable:
+    w, h, cell = int(raw["width"]), int(raw["height"]), float(raw["cell_m"])
+    ox, oz = (float(v) for v in raw["origin"])
+    cost = np.asarray(raw["cost"], np.float32).reshape(h, w)
+
+    def passable(xs: np.ndarray, zs: np.ndarray) -> np.ndarray:
+        c = np.floor((np.asarray(xs, float) - ox) / cell).astype(int)
+        r = np.floor((np.asarray(zs, float) - oz) / cell).astype(int)
+        inside = (r >= 0) & (c >= 0) & (r < h) & (c < w)
+        out = np.zeros(np.shape(c), bool)
+        out[inside] = cost[r[inside], c[inside]] >= 0
+        return out
+
+    return passable
+
+
+class KeepInBounds:
+    def __init__(
+        self,
+        bounds: list[float],
+        passable: Passable | None = None,
+        margin: float = BOUNDS_MARGIN,
+        half_width: float = FOOTPRINT_HALF_WIDTH,
+        half_length: float = FOOTPRINT_HALF_LENGTH,
+    ) -> None:
+        xmin, zmin, xmax, zmax = (float(v) for v in bounds)
+        self.lo = np.array([xmin + margin, zmin + margin])
+        self.hi = np.array([xmax - margin, zmax - margin])
+        self.passable = passable
+        self.half_width, self.half_length = half_width, half_length
+
+    def corners(self, x: float, z: float, yaw: float) -> np.ndarray:
+        s, c = math.sin(math.radians(yaw)), math.cos(math.radians(yaw))
+        fwd, right = np.array([s, c]), np.array([c, -s])
+        return np.array([x, z]) + np.array([fwd * a + right * b for a in (self.half_length, -self.half_length) for b in (self.half_width, -self.half_width)])
+
+    def blocked(self, x: float, z: float, yaw: float) -> int:
+        pts = self.corners(x, z, yaw)
+        out = int(np.sum(np.any((pts < self.lo) | (pts > self.hi), axis=1)))
+        if self.passable is not None:
+            out = max(out, int(np.sum(~self.passable(pts[:, 0], pts[:, 1]))))
+        return out
+
+    def resolve(self, prev: tuple[float, float, float], nxt: tuple[float, float, float]) -> tuple[tuple[float, float, float], str]:
+        before = self.blocked(*prev)
+
+        def ok(p: tuple[float, float, float]) -> bool:
+            n = self.blocked(*p)
+            return n == 0 or (before > 0 and n <= before)
+
+        x, z = np.clip(nxt[0], self.lo[0], self.hi[0]), np.clip(nxt[1], self.lo[1], self.hi[1])
+        if ok((x, z, nxt[2])):
+            return (float(x), float(z), nxt[2]), "ok" if (x, z) == (nxt[0], nxt[1]) else "slide"
+        dx, dz = x - prev[0], z - prev[1]
+        for p in ((prev[0] + dx, prev[1] + dz, prev[2]), (prev[0] + dx, prev[1], prev[2]), (prev[0], prev[1] + dz, prev[2])):
+            if math.hypot(p[0] - prev[0], p[1] - prev[1]) > max(1e-6, MIN_SLIDE * math.hypot(dx, dz)) and ok(p):
+                return (float(p[0]), float(p[1]), p[2]), "slide"
+        return prev, "blocked"
+
