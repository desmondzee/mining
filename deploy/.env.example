# Copy to deploy/.env and fill in. Every key is optional: the demo degrades gracefully.
# NEVER commit deploy/.env.

# --- LLM dispatcher (missing -> regex/keyword fallback parser) ---
OPENAI_API_KEY=
# Optional OpenAI-compatible gateway (e.g. Vercel AI Gateway). Leave empty for api.openai.com.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# --- ElevenLabs voice: STT + TTS (missing -> audio_url null, browser speechSynthesis / typed commands) ---
ELEVENLABS_API_KEY=
# Comma-separated voice IDs, one per truck; dispatch uses the first.
ELEVENLABS_VOICE_IDS=

# --- Reactor LingBot World 2 driver's-eye stream (missing -> "stream unavailable") ---
# Server exchanges this for a short-lived JWT; it never reaches the browser.
REACTOR_API_KEY=

# --- World Labs Marble (only needed for `python -m envgen.worldlabs`) ---
WLT_API_KEY=

# Where worlds live inside the containers (../data is mounted here). Don't change.
DATA_DIR=/app/data

# --- Deploy ---
# Host port for the web (nginx) container.
WEB_PORT=8080
# Public domain for the `tls` profile (Caddy auto-HTTPS). DNS A record must point at this server.
DOMAIN=
